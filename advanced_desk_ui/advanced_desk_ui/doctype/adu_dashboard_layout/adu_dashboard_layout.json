{
	"doctype": "DocType",
	"name": "ADU Dashboard Layout",
	"module": "Advanced Desk UI",
	"custom": 0,
	"engine": "InnoDB",
	"autoname": "field:user",
	"fields": [
		{
			"fieldname": "user",
			"fieldtype": "Link",
			"options": "User",
			"label": "User",
			"reqd": 1,
			"unique": 1
		},
		{
			"fieldname": "layout",
			"fieldtype": "Long Text",
			"label": "Layout (JSON)",
			"description": "Array of {widget, x, y, w, h} objects describing the user's dashboard grid."
		}
	],
	"permissions": [
		{
			"role": "All",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"if_owner": 1
		}
	]
}
