{
	"doctype": "DocType",
	"name": "ADU Favorite",
	"module": "Advanced Desk UI",
	"custom": 0,
	"engine": "InnoDB",
	"autoname": "hash",
	"fields": [
		{
			"fieldname": "user",
			"fieldtype": "Link",
			"options": "User",
			"label": "User",
			"reqd": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "item_type",
			"fieldtype": "Select",
			"options": "Workspace\nReport\nDocType\nPage",
			"label": "Item Type",
			"reqd": 1
		},
		{
			"fieldname": "item_value",
			"fieldtype": "Data",
			"label": "Item Value",
			"reqd": 1,
			"description": "The route/name of the workspace, report, doctype or page."
		},
		{
			"fieldname": "label",
			"fieldtype": "Data",
			"label": "Display Label"
		},
		{
			"fieldname": "icon",
			"fieldtype": "Data",
			"label": "Icon"
		},
		{
			"fieldname": "sort_order",
			"fieldtype": "Int",
			"label": "Sort Order",
			"default": 0
		}
	],
	"permissions": [
		{
			"role": "All",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"if_owner": 1
		}
	]
}
