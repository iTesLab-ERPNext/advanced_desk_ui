{
	"doctype": "DocType",
	"name": "Advanced Desk Settings",
	"module": "Advanced Desk UI",
	"issingle": 1,
	"custom": 0,
	"track_changes": 1,
	"engine": "InnoDB",
	"fields": [
		{
			"fieldname": "branding_tab",
			"fieldtype": "Tab Break",
			"label": "Branding"
		},
		{
			"fieldname": "company_logo",
			"fieldtype": "Attach Image",
			"label": "Company Logo"
		},
		{
			"fieldname": "login_logo",
			"fieldtype": "Attach Image",
			"label": "Login Logo"
		},
		{
			"fieldname": "favicon",
			"fieldtype": "Attach Image",
			"label": "Favicon"
		},
		{
			"fieldname": "background_image",
			"fieldtype": "Attach Image",
			"label": "Login Background / Wallpaper"
		},
		{
			"fieldname": "column_break_branding",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "font",
			"fieldtype": "Select",
			"label": "Font",
			"options": "Inter\nSystem Default\nRoboto\nOpen Sans",
			"default": "Inter"
		},
		{
			"fieldname": "theme_tab",
			"fieldtype": "Tab Break",
			"label": "Theme"
		},
		{
			"fieldname": "default_theme",
			"fieldtype": "Select",
			"label": "Default Theme",
			"options": "Light\nDark\nAuto",
			"default": "Light",
			"reqd": 1
		},
		{
			"fieldname": "primary_color",
			"fieldtype": "Color",
			"label": "Primary Color",
			"default": "#4f46e5"
		},
		{
			"fieldname": "secondary_color",
			"fieldtype": "Color",
			"label": "Secondary Color",
			"default": "#6b7280"
		},
		{
			"fieldname": "accent_color",
			"fieldtype": "Color",
			"label": "Accent Color",
			"default": "#06b6d4"
		},
		{
			"fieldname": "column_break_theme",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "sidebar_color",
			"fieldtype": "Color",
			"label": "Sidebar Color"
		},
		{
			"fieldname": "navbar_color",
			"fieldtype": "Color",
			"label": "Navbar Color"
		},
		{
			"fieldname": "button_radius",
			"fieldtype": "Int",
			"label": "Button / Card Radius (px)",
			"default": 12
		},
		{
			"fieldname": "layout_tab",
			"fieldtype": "Tab Break",
			"label": "Layout & Behavior"
		},
		{
			"fieldname": "sidebar_width",
			"fieldtype": "Int",
			"label": "Sidebar Width (px)",
			"default": 268
		},
		{
			"fieldname": "navbar_height",
			"fieldtype": "Int",
			"label": "Navbar Height (px)",
			"default": 60
		},
		{
			"fieldname": "animation_speed",
			"fieldtype": "Select",
			"label": "Animation Speed",
			"options": "Fast\nNormal\nSlow",
			"default": "Normal"
		},
		{
			"fieldname": "column_break_layout",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "enable_animations",
			"fieldtype": "Check",
			"label": "Enable Animations",
			"default": 1
		},
		{
			"fieldname": "enable_glass_effect",
			"fieldtype": "Check",
			"label": "Enable Glass Effect",
			"default": 0
		},
		{
			"fieldname": "enable_blur",
			"fieldtype": "Check",
			"label": "Enable Blur",
			"default": 0
		},
		{
			"fieldname": "compact_mode",
			"fieldtype": "Check",
			"label": "Compact Mode (default for new users)",
			"default": 0
		},
		{
			"fieldname": "dashboard_tab",
			"fieldtype": "Tab Break",
			"label": "Dashboard"
		},
		{
			"fieldname": "dashboard_widgets_editable",
			"fieldtype": "Check",
			"label": "Allow Users to Customize Dashboard Widgets",
			"default": 1
		},
		{
			"fieldname": "default_dashboard_layout",
			"fieldtype": "Code",
			"options": "JSON",
			"label": "Default Dashboard Layout (JSON)",
			"description": "Fallback widget layout used for users who haven't customized their own."
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 0
		}
	]
}
